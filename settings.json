{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -File \"$HOME/.claude/hooks/rtk-hook.ps1\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(rtk:*)",
      "Bash(podman:*)",
      "Bash(docker:*)",
      "Bash(terraform:*)",
      "Bash(ansible:*)",
      "Bash(kubectl:*)",
      "Bash(helm:*)",
      "Bash(az:*)",
      "Bash(aws:*)",
      "Bash(gcloud:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(uv:*)",
      "Bash(python:*)",
      "Bash(git:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)"
    ]
  },
  "env": {
    "RTK_TELEMETRY_DISABLED": "1",
    "CLAUDE_CONFIG_DIR": "$HOME/.claude"
  }
}